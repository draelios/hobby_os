generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  name        String?
  timezone    String      @default("UTC")
  currency    String      @default("USD")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tags        Tag[]
  notes       Note[]
  activities  Activity[]
  books       Book[]
  recipes     Recipe[]
  accounts    FinanceAccount[]
  entries     FinanceEntry[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  module      String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Book {
  id            String     @id @default(cuid())
  userId        String
  title         String
  author        String?
  status        BookStatus @default(WANT_TO_READ)
  totalPages    Int?
  currentPage   Int?
  rating        Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recipe {
  id            String    @id @default(cuid())
  userId        String
  title         String
  description   String?
  steps         String?
  servings      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id            String   @id @default(cuid())
  userId        String
  name          String
  type          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries       FinanceEntry[]
}

model FinanceEntry {
  id            String      @id @default(cuid())
  userId        String
  accountId     String
  kind          EntryKind
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("USD")
  category      String
  note          String?
  occurredAt    DateTime
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

enum BookStatus {
  WANT_TO_READ
  READING
  COMPLETED
}

enum EntryKind {
  INCOME
  EXPENSE
  TRANSFER
}
