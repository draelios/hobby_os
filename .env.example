# App
NODE_ENV=production
APP_PORT=3000
APP_BASE_URL=https://hobbies.local
APP_DOMAIN=hobbies.local

# Postgres
POSTGRES_DB=hobby_os
POSTGRES_USER=hobby_admin
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hobby_admin:change-me@db:5432/hobby_os?schema=public

# Auth
NEXTAUTH_URL=https://hobbies.local
NEXTAUTH_SECRET=replace-with-long-random-string

# Backups
BACKUP_RETENTION_DAYS=14
